# =============================================================================
# Python 크롤러용 .env 템플릿
# =============================================================================
# 사용법:
#   1. 이 파일을 복사하여 python/.env 생성
#   2. 모든 "your-xxx" 부분을 실제 값으로 변경
#   3. Git에 커밋하지 마세요! (.gitignore에 이미 추가되어 있음)
# =============================================================================

# MySQL Database Configuration
DB_HOST=your-rds-endpoint.ap-northeast-2.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your-secure-password
DB_NAME=my_app_db
DB_CHARSET=utf8

# Python 환경 설정
PYTHON_ENV=development
